# Local run (`make run`) against ../docker-compose.yml: start it with `docker compose up -d postgres rabbitmq migrate-vote`.
APP_HTTP_PORT=8080
DB_URL=postgres://vote:vote@127.0.0.1:15432/vote_db?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:15675/
OUTBOX_INTERVAL=1s
# Leave empty to answer from the static list of polls until Poll Service exists.
POLL_SERVICE_ADDR=
